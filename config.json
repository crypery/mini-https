{
    "ssl_use": true,
    "port": 443,
    "upload_dir": "www/upload",
    "cert_file": "localhost.crt",
    "key_file": "localhost.key",
    "max_clients": 1024,
    "timeout_io": 5000,
    "timeout_handshake": 5000,
    "timeout_tls_poll": 500,
    "timeout_flight": 5000,
    "timeout_accept": 1000,
    "worker_threads": 64,
    "max_body_mb": 0,
    "log_file": "server.log",
    "log_output": 3,
    "log_level": 0,
    "server_name": "nginx/1.25.2",
    "domains": {
        "localhost": "www",
        "127.0.0.1": "www",
    },
    "www_redirect": true
}
